load("frmgham_recoded.wide.Rdata")
# Proportion in each outcome category
table(frmgham_recoded.wide$hyperten)/sum(table(frmgham_recoded.wide$hyperten))
# Make 2nd category (BMI 18.5-24.9, ideal weight) the referent group:
frmgham_recoded.wide <- frmgham_recoded.wide %>%
mutate(bmi_bin = ifelse(bmi <= 24.9, 0, 1))
# Estimate logistic regression:
logistic.frmgham <- glm(hyperten ~ bmi_bin*cursmoke + factor(sex) + age +
factor(educ),
data=frmgham_recoded.wide, family=binomial)
summary(logistic.frmgham)
# Required packages
library(multcomp)
library(parameters)
# Create comparison matrix - Comparing High BMI to low BMI when cursmoke = 0
K1 = matrix(c(0,1,0,0,0,0,0,0,0), nrow = 1)
# Compute coefficients in comparison of interest
comp.nosmoke <- glht(logistic.frmgham, linfct = K1)
# Retrieve model parameters
model_parameters(comp.nosmoke, ci = 0.95, exponentiate = TRUE)
# Create comparison matrix - Comparing High BMI to low BMI when cursmoke = 1
K2 = matrix(c(0,1,0,0,0,0,0,0,1), nrow = 1)
# Compute coefficients in comparison of interest
comp.smoke <- glht(logistic.frmgham, linfct = K2)
# Retrieve model parameters
model_parameters(comp.smoke, ci = 0.95, exponentiate = TRUE)
# Create comparison matrix - Comparing BMI = 1, cursmoke = 1 to BMI = 0, cursmoke = 0
K3 = matrix(c(0,1,1,0,0,0,0,0,1), nrow = 1)
# Compute coefficients in comparison of interest
comp.smoke <- glht(logistic.frmgham, linfct = K3)
# Retrieve model parameters
model_parameters(comp.smoke, ci = 0.95, exponentiate = TRUE)
# Create 4 way variable
frmgham_recoded.wide <- frmgham_recoded.wide %>% mutate(bmi_x_smoke =
ifelse(bmi_bin == 1 & cursmoke == 1, "HighBMI_Smoke",
ifelse(bmi_bin == 0 & cursmoke == 1, "lowBMI_Smoke",
ifelse(bmi_bin == 1 & cursmoke == 0, "HighBMI_noSmoke",
"lowBMI_noSmoke"))))
# make the doubly unexposed group the reference
frmgham_recoded.wide$bmi_x_smoke <-
relevel(as.factor(frmgham_recoded.wide$bmi_x_smoke),"lowBMI_noSmoke")
# Estimate logistic regression:
logistic.frmgham.int <- glm(hyperten ~ bmi_x_smoke +
factor(sex) + age + factor(educ),
data=frmgham_recoded.wide, family=binomial)
summary(logistic.frmgham.int)
coef.int <- coef(logistic.frmgham.int)
ci.int <- confint.default(logistic.frmgham.int)
round(exp(cbind(coef.int, ci.int))[2:4,],2)
?glht
?glm
load("frmgham_recoded.wide.Rdata")
df_name <- frmgham_recoded.wide
df_name <- df_name %>%
mutate(E = ifelse(bmi <= 24.9, 0, 1))
df_name$Y <- df_name$hyperten
df_name$G <- df_name$cursmoke
df_name$L <- df_name$sex - 1
EMModel <- glm(Y ~ E + G + E*G + L,
data = df_name
family = binomial)
summary(EMModel)
EMModel <- glm(Y ~ E + G + E*G + L,
data = df_name,
family = binomial)
summary(EMModel)
# Required packages
library(multcomp)
library(parameters)
library(tidyverse)
#view coefficients
coef(EMModel)
#view coefficients
coef(EMModel) # we have 5
# Create comparison matrix - Comparing High BMI to low BMI when cursmoke = 0
K1 = matrix(c(0,1,0,0,0), nrow = 1)
# Compute coefficients in comparison of interest
comp1 <- glht(EMModel, linfct = K1)
# Retrieve model parameters
model_parameters(comp1, ci = 0.95, exponentiate = TRUE)
