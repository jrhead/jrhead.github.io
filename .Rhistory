library(ggdag)
library(dplyr)
library(ggplot2)
theme_set(theme_dag())
dagify(
Y ~ A,
labels = c(Y = "Infection", A = "Race"),
coords = list(x = c(A = 1, Y = 2),
y = c(A = 1, Y = 1))
) %>% ggdag()
dagify(
Y ~ A,
labels = c(Y = "Infection", A = "Race"),
coords = list(x = c(A = 1, Y = 2),
y = c(A = 1, Y = 1))
) %>% ggdag(use_labels = "label", text = T)
dagify(
Y ~ M,
M ~ A,
labels = c(Y = "Infection", A = "Race", M = "Work"),
coords = list(x = c(A = 1, Y = 2, M = 1.5),
y = c(A = 1, Y = 1, M = 1))
) %>% ggdag(use_labels = "label", text = T)
dagify(
Y ~ A + M,
M ~ A,
labels = c(Y = "Infection", A = "Race", M = "Work"),
coords = list(x = c(A = 1, Y = 2, M = 1.5),
y = c(A = 1, Y = 1, M = 1.5))
) %>% ggdag(use_labels = "label", text = T)
load("frmgham_recoded.wide.Rdata")
# Proportion in each outcome category
table(frmgham_recoded.wide$hyperten)/sum(table(frmgham_recoded.wide$hyperten))
# Make 2nd category (BMI 18.5-24.9, ideal weight) the referent group:
frmgham_recoded.wide$bmi_cat <-
relevel(as.factor(frmgham_recoded.wide$bmi_cat),"2")
# Estimate logistic regression:
logistic.frmgham <- glm(hyperten ~ factor(bmi_cat) + cursmoke +
age + factor(sex) + factor(educ),
data=frmgham_recoded.wide, family=binomial)
# Retrieve coefficient values
summary(logistic.frmgham)
coef.logistic <- coef(logistic.frmgham)
ci.logistic <- confint.default(logistic.frmgham)
round(exp(cbind(coef.logistic, ci.logistic))[2:4,],2)
round(exp(cbind(coef.logistic, ci.logistic))[2:4,],2)
