library(ggdag)
library(ggplot2)
theme_set(theme_dag())
collide <- dagify(
A_star ~ A + Y,
coords = list(x = c(A_star = 1, Y = 2, A = 1),
y = c(A_star = 2, Y = 1, A = 1))
)
ggdag_status(collide) +
guides(fill = "none", color = "none") +  # Disable the legend
theme_dag()
